{
  "outputDirectory": "public",
  "functions": {
    "api/hunt.js": {
      "maxDuration": 60
    },
    "api/mirror.js": {
      "maxDuration": 60
    },
    "api/add.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?r=home"
    },
    {
      "source": "/ofertas",
      "destination": "/api/site?r=ofertas"
    },
    {
      "source": "/cupons",
      "destination": "/api/site?r=cupons"
    },
    {
      "source": "/categorias",
      "destination": "/api/site?r=categorias"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/api/site?r=categoria&slug=:slug"
    },
    {
      "source": "/grupos",
      "destination": "/api/site?r=grupos"
    },
    {
      "source": "/grupo-feminino",
      "destination": "/api/site?r=feminino"
    },
    {
      "source": "/painel",
      "destination": "/painel.html"
    },
    {
      "source": "/p/:code",
      "destination": "/api/p?code=:code"
    }
  ]
}
